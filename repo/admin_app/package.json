{
  "name": "xylium-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Xylium Admin Application: React UI + Node.js API for SDK configuration (one deployable)",
  "main": "server/src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/src/server.js",
    "dev:server": "node --watch server/src/server.js",
    "dev:web": "vite --config web/vite.config.mjs",
    "build": "vite build --config web/vite.config.mjs",
    "migrate": "node server/scripts/migrate.js",
    "create-user": "node server/scripts/create-user.js",
    "import-from-env": "node server/scripts/import-from-env.js",
    "gen-keys": "node server/scripts/gen-keys.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js"
  },
  "dependencies": {
    "@xylium/config": "file:../packages/xylium-config",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.7"
  }
}
