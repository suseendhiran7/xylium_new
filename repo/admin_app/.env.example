# ======================================================================
# Xylium Admin Application — copy to admin_app/.env
# Generate the keys with:   npm run gen-keys
# ======================================================================

NODE_ENV=development

# Browser UI + /api
PORT=8090

# SDK-facing /internal API (HMAC-signed). Bind it to a private interface;
# SDK instances call ADMIN_INTERNAL_URL=http://<this host>:8091
INTERNAL_PORT=8091
INTERNAL_HOST=127.0.0.1

# The admin app's OWN PostgreSQL database (not the SDK's event database).
# Create it once:  CREATE DATABASE xylium_admin;
ADMIN_DB_URL=postgres://postgres:CHANGE_ME@localhost:5432/xylium_admin
ADMIN_DB_SSL=false

# AES-256-GCM key(s) for stored secrets: id:base64(32 bytes), comma-separated.
# The first is used for new values unless CONFIG_ENCRYPTION_ACTIVE_KEY names another.
# Never change or remove a key that existing versions were encrypted with.
CONFIG_ENCRYPTION_KEYS=k1:REPLACE_WITH_gen-keys_OUTPUT
# CONFIG_ENCRYPTION_ACTIVE_KEY=k1

# HMAC keys. SDK → admin (verify): id:secret list. Admin → SDK (sign): one id + secret.
# The SDK side gets the mirror image (see node_app/.env.example).
SDK_TO_ADMIN_KEYS=sdk-1:REPLACE_WITH_gen-keys_OUTPUT
ADMIN_TO_SDK_KEY_ID=admin-1
ADMIN_TO_SDK_KEY=REPLACE_WITH_gen-keys_OUTPUT

# host:port of every SDK instance base URL the admin app may call
# (must match SDK_INTERNAL_BASE_URL on each instance).
SDK_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080

# Session cookie "Secure" flag: defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# An instance without a heartbeat for this long is "stale" and not notified.
INSTANCE_STALE_SECONDS=90
